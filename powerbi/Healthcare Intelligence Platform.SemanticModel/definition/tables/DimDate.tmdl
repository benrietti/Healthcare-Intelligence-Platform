	partition DimDate-69769d42-b9c5-4e00-9828-cdfd7242fd60 = calculated
		mode: import
		source =
				
				VAR AllDates =
				    FILTER(
				        UNION(
				            SELECTCOLUMNS(
				                'rpt_encounter_risk_scorecard',
				                "ReportDate", 'rpt_encounter_risk_scorecard'[admission_date]
				            ),
				            SELECTCOLUMNS(
				                'rpt_facility_daily_summary',
				                "ReportDate", 'rpt_facility_daily_summary'[admission_date]
				            ),
				            SELECTCOLUMNS(
				                'rpt_data_quality_overview',
				                "ReportDate", 'rpt_data_quality_overview'[reporting_date]
				            )
				        ),
				        NOT ISBLANK([ReportDate])
				    )
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(
				            DATE(YEAR(MINX(AllDates, [ReportDate])), 1, 1),
				            DATE(YEAR(MAXX(AllDates, [ReportDate])), 12, 31)
				        ),
				        "Year", YEAR([Date]),
				        "Month Number", MONTH([Date]),
				        "Month", FORMAT([Date], "MMM"),
				        "Year Month", FORMAT([Date], "yyyy-MM"),
				        "Year Month Sort", YEAR([Date]) * 100 + MONTH([Date])
				    )

	annotation PBI_Id = 37d0d3a14e7348139a1294c82628899e

