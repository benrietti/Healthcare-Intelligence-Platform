table rpt_encounter_risk_scorecard
	lineageTag: 7145e512-75d7-4cfd-b4ae-b6fec70051b1

	measure 'Total Encounters' =
			
			COUNTROWS('rpt_encounter_risk_scorecard')
		formatString: 0
		lineageTag: 2fb0d303-fe6c-4095-9455-e898ef75b9ac

	measure 'Unique Patients' =
			
			DISTINCTCOUNT('rpt_encounter_risk_scorecard'[patient_id])
		formatString: 0
		lineageTag: 8eb5dfc6-0fb4-4e93-8c50-13fb1e7544a4

	measure 'Readmitted Encounters' =
			
			CALCULATE(
			    [Total Encounters],
			    'rpt_encounter_risk_scorecard'[readmitted_30d] = TRUE()
			)
		formatString: 0
		lineageTag: ab6cdb7a-298e-4c5c-ae5e-4442f22a118a

	measure 'Readmission Rate' =
			
			DIVIDE([Readmitted Encounters], [Total Encounters])
		lineageTag: 3ab3bd4e-c544-4066-9e77-f730456e415f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average LOS Hours' =
			
			AVERAGE('rpt_encounter_risk_scorecard'[length_of_stay_hours])
		lineageTag: 44ab385d-4863-4385-af43-a6a5c45c29ab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average LOS Days' =
			
			DIVIDE([Average LOS Hours], 24)
		lineageTag: 19170dca-4383-4077-bdaf-d1e5c6d43cc1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Billed' =
			
			SUM('rpt_encounter_risk_scorecard'[billed_amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 7e983492-1acc-4b19-8276-715a7bcc21c5

		changedProperty = FormatString

	measure 'Total Allowed' =
			
			SUM('rpt_encounter_risk_scorecard'[allowed_amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 191eeb80-33fc-4a75-b115-99dc6f19af2e

		changedProperty = FormatString

	measure 'Total Paid' =
			
			SUM('rpt_encounter_risk_scorecard'[paid_amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: c48abbfa-8185-4b2b-a1e2-06e4563aa9d1

		changedProperty = FormatString

	measure 'Denied Claims' =
			
			SUM('rpt_encounter_risk_scorecard'[denied_claim_count])
		formatString: 0
		lineageTag: 60b0e39d-7b14-4f9a-ae56-25ca1ab929bb

	measure 'Readmission Scored Encounters' =
			
			COUNT('rpt_encounter_risk_scorecard'[readmission_probability])
		formatString: 0
		lineageTag: 989d7efc-ac36-484e-9db4-02f2b51c906b

	measure 'Readmission Scoring Coverage' =
			
			DIVIDE([Readmission Scored Encounters], [Total Encounters])
		lineageTag: b606f1db-5a52-4319-9b11-400074b88148

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Predicted Readmission Risk' =
			
			AVERAGE('rpt_encounter_risk_scorecard'[readmission_probability])
		lineageTag: 595aa5c8-5e4b-4168-ba2d-eb13a5899217

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LOS Scored Encounters' =
			
			COUNT('rpt_encounter_risk_scorecard'[length_of_stay_hours_predicted])
		formatString: 0
		lineageTag: 60632af4-9a9b-422d-a98f-3aa99a398cbe

	measure 'LOS Scoring Coverage' =
			
			DIVIDE([LOS Scored Encounters], [Total Encounters])
		lineageTag: 0c4c1b4d-99e0-4f58-8a9f-e3d2159f5808

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Predicted LOS Hours' =
			
			AVERAGE('rpt_encounter_risk_scorecard'[length_of_stay_hours_predicted])
		lineageTag: f3c6b640-c417-47ee-9853-45cbe5b30d17

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LOS MAE Hours' =
			
			AVERAGEX(
			    FILTER(
			        'rpt_encounter_risk_scorecard',
			        NOT ISBLANK('rpt_encounter_risk_scorecard'[length_of_stay_hours_predicted])
			            && NOT ISBLANK('rpt_encounter_risk_scorecard'[length_of_stay_hours])
			    ),
			    ABS(
			        'rpt_encounter_risk_scorecard'[length_of_stay_hours_predicted]
			            - 'rpt_encounter_risk_scorecard'[length_of_stay_hours]
			    )
			)
		lineageTag: 8d09070b-0056-4a77-b82a-3169c8f83154

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Clinical Events' =
			
			SUM('rpt_encounter_risk_scorecard'[event_count])
		formatString: 0
		lineageTag: 2c90c587-94c3-453d-a172-499d3c599b6e

	measure 'Events Missing Timestamp' =
			
			SUM('rpt_encounter_risk_scorecard'[events_missing_timestamp])
		formatString: 0
		lineageTag: 138d273c-8385-4bec-9b9a-4673e7de10d0

	measure 'Missing Timestamp Rate' =
			
			DIVIDE([Events Missing Timestamp], [Total Clinical Events])
		lineageTag: 754ccc16-ba10-40eb-bea5-49aa623b2054

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Events Missing Department' =
			
			SUM('rpt_encounter_risk_scorecard'[events_missing_department])
		formatString: 0
		lineageTag: e8de18c2-3b22-4de8-baf1-6180e8424504

	measure 'Missing Department Rate' =
			
			DIVIDE([Events Missing Department], [Total Clinical Events])
		lineageTag: fc793f0b-1552-49b9-8086-a70da70ee32c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Events Over 24 Hours Late' =
			
			SUM('rpt_encounter_risk_scorecard'[events_arriving_over_24h_late])
		formatString: 0
		lineageTag: a588d774-6b64-43a1-9583-5f97a6eb715a

	measure 'Late Arrival Rate' =
			
			DIVIDE([Events Over 24 Hours Late], [Total Clinical Events])
		lineageTag: 6fb804fd-4efe-424c-b878-4fbe4e0e13ff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Scored Cohort Actual Readmission Rate' =
			
			VAR ScoredEncounters =
			    FILTER(
			        'rpt_encounter_risk_scorecard',
			        NOT ISBLANK(
			            'rpt_encounter_risk_scorecard'[readmission_probability]
			        )
			    )
			RETURN
			    DIVIDE(
			        COUNTROWS(
			            FILTER(
			                ScoredEncounters,
			                'rpt_encounter_risk_scorecard'[readmitted_30d] = TRUE()
			            )
			        ),
			        COUNTROWS(ScoredEncounters)
			    )
		lineageTag: 6e27b84a-87a0-4c32-8443-cfbeb67e6158

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Scored Cohort Actual LOS Hours' =
			
			AVERAGEX(
			    FILTER(
			        'rpt_encounter_risk_scorecard',
			        NOT ISBLANK(
			            'rpt_encounter_risk_scorecard'[length_of_stay_hours_predicted]
			        )
			    ),
			    'rpt_encounter_risk_scorecard'[length_of_stay_hours]
			)
		lineageTag: f4058e67-fb27-4780-84cb-76e92fbc1c7b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

