				            SELECTCOLUMNS(
				                'rpt_facility_daily_summary',
				                "service_line", 'rpt_facility_daily_summary'[service_line]
				            )
				        )
				    ),
				    NOT ISBLANK([service_line])
				)

	annotation PBI_Id = ad6177e5d1dc49b39e2042688339cf70

