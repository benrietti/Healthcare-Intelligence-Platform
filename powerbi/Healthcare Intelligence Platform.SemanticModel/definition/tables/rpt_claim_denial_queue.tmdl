table rpt_claim_denial_queue
	lineageTag: d43d8630-472f-43bf-a93a-3699e71f57dd

	measure 'Scored Claims' = COUNTROWS(rpt_claim_denial_queue)
		formatString: 0
		lineageTag: d29e1c56-f4e9-44bc-99b6-4dc17689349b

	measure 'Average Denial Risk' = AVERAGE(rpt_claim_denial_queue[denial_probability])
		formatString: 0.0%
		lineageTag: b79890a3-45de-4a90-b9b0-76ef019363be

	measure 'High Risk Claims' = CALCULATE(COUNTROWS(rpt_claim_denial_queue), rpt_claim_denial_queue[denial_probability] >= 0.5)
		formatString: 0
		lineageTag: 4634cb29-757e-4216-801d-064367156318

