table rpt_data_quality_overview
	lineageTag: 8861117a-7edf-4178-86ba-5ec40a8b22d3

	measure 'Total Ingestion Runs' =
			
			SUM('rpt_data_quality_overview'[ingest_run_count])
		formatString: 0
		lineageTag: eb8cd8fd-2ff3-43d1-9c88-b45aa21aa010

	measure 'Successful Ingestion Runs' =
			
			SUM('rpt_data_quality_overview'[ingest_run_success_count])
		formatString: 0
		lineageTag: 02afeef1-be18-4751-803e-3bea40e40467

	measure 'Failed Ingestion Runs' =
			
			SUM('rpt_data_quality_overview'[ingest_run_failure_count])
		formatString: 0
		lineageTag: 5d598c79-03ae-48f9-8bb9-a439617b9a4a

	measure 'Ingestion Success Rate' =
			
			DIVIDE([Successful Ingestion Runs], [Total Ingestion Runs])
		lineageTag: 96aa2562-a364-4db1-8dd1-bd20423ecc59

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last Ingestion Started At' =
			
