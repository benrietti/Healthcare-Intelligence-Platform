		sourceColumn: [service_line]

		annotation SummarizationSetBy = Automatic

	partition DimServiceLine-1fb3146e-52d0-46de-bb20-f019bf915da0 = calculated
		mode: import
		source =
				
				FILTER(
				    DISTINCT(
				        UNION(
				            SELECTCOLUMNS(
				                'rpt_encounter_risk_scorecard',
				                "service_line", 'rpt_encounter_risk_scorecard'[service_line]
